#!/bin/bash
# usage: with-root-token <wrapping-token> <command...>
# Run a command with a short-lived root token in VAULT_TOKEN, revoked afterwards.
#
# scripts/vault-ops.sh mints the token on your machine (a child of the root token,
# response-wrapped: single use, expires after 60 s) and passes only the wrapping
# token here. The root token itself never reaches the node.

# node.env is generated by Terraform and only exists on the node.
# shellcheck disable=SC1091
set -euo pipefail
set -a; . /etc/vault-node/node.env; set +a
[ $# -ge 2 ] || { echo "usage: with-root-token <wrapping-token> <command...>" >&2; exit 2; }

VAULT_TOKEN=$(VAULT_TOKEN=$1 vault unwrap -field=token)
export VAULT_TOKEN
shift
# Fails harmlessly after a restore, which replaces the token store anyway.
trap 'vault token revoke -self >/dev/null 2>&1 || true' EXIT
"$@"
